# Copy to .env for local dev. For Vercel: set these in Project Settings → Environment Variables.

# ─── Sign-in (required) ──────────────────────────────────────────────────────
# Password to access the dashboard. Pick a strong one.
DASHBOARD_PASSWORD=change-me-to-a-strong-password
# Random string used to sign session cookies. 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-32-plus-random-chars

# ─── Google OAuth (file-based, for local dev) ────────────────────────────────
# Path to the OAuth client secret JSON downloaded from Google Cloud Console.
GOOGLE_OAUTH_CLIENT=credentials/client_secret_xxx.apps.googleusercontent.com.json
GOOGLE_TOKEN_PATH=credentials/google-token.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4177/oauth2callback

# ─── Google OAuth (env-based, for Vercel) ────────────────────────────────────
# On Vercel the filesystem is read-only, so paste the JSON content directly:
# GOOGLE_OAUTH_CLIENT_JSON={"web":{"client_id":"...","client_secret":"..."}}
# Generate the refresh token by running locally first, then copy it from credentials/google-token.json:
# GOOGLE_REFRESH_TOKEN=1//0g...
# Production redirect URI:
# GOOGLE_OAUTH_REDIRECT_URI=https://your-app.vercel.app/oauth2callback

# ─── Sites config ────────────────────────────────────────────────────────────
# Path to the sites file (used locally).
SITES_CONFIG=config/sites.json
# OR paste the entire sites.json content for Vercel:
# SITES_CONFIG_JSON={"timezone":"Asia/Colombo","sites":[{"id":"...","name":"...","propertyId":"...","launchDate":"..."}]}

# ─── Service account alternative (instead of OAuth) ──────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
